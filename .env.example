# Frontend
VITE_API_BASE_URL=http://localhost:3010
VITE_SITE_URL=http://localhost:5173

# Backend
PORT=3010
NODE_ENV=development
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=15000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Live WooCommerce Store API (no secrets required for Store API)
WOOCOMMERCE_BASE_URL=https://batshi-home.co.il

# Reserved for a later authenticated REST v3 phase. Do not put these in the browser.
# Not required to start the server. Leave empty.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_API_VERSION=wc/v3
