{
  "name": "@batshi/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run --exclude 'src/**/*.live.test.ts'",
    "test:live": "vitest run src/app.live.test.ts src/integrations/woocommerce/storeApi.live.test.ts",
    "test:all": "vitest run",
    "analytics:seed-demo": "tsx src/scripts/seedAnalyticsDemo.ts",
    "analytics:clear-demo": "tsx src/scripts/seedAnalyticsDemo.ts --clear"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "axios": "^1.11.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  }
}
